# Google Search Console MCP Server - Environment Variables
# Copy this file to .env and fill in your values

# Google OAuth (use credentials from your own Desktop OAuth application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mutating tools are disabled unless this exact value is true.
SEARCH_CONSOLE_MCP_ENABLE_WRITE_TOOLS=false

# Optional Bing environment credential. Interactive setup stores it in keychain.
# BING_API_KEY=

# PageSpeed Insights API Key (optional, increases quota from ~100 to 25,000/day)
# Get one free at: https://console.cloud.google.com/apis/credentials
# Enable the "PageSpeed Insights API" in your GCP project first.
PAGESPEED_API_KEY=

# Option 1: File-based credentials (recommended for local development)
# Path to your Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=

# Option 2: Environment variable credentials (for serverless/Cloudflare)
# Use these if you cannot use a credentials file
# GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
